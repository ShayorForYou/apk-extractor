<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press launcher shortcuts. MainActivity maps the actions to ui.Shortcut. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_install"
        android:shortcutId="install"
        android:shortcutLongLabel="@string/shortcut_install_long"
        android:shortcutShortLabel="@string/shortcut_install_short">
        <intent
            android:action="com.shayor.apkextractor.action.INSTALL"
            android:targetClass="com.shayor.apkextractor.MainActivity"
            android:targetPackage="com.shayor.apkextractor" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_backup"
        android:shortcutId="backup_all"
        android:shortcutLongLabel="@string/shortcut_backup_long"
        android:shortcutShortLabel="@string/shortcut_backup_short">
        <intent
            android:action="com.shayor.apkextractor.action.BACKUP_ALL"
            android:targetClass="com.shayor.apkextractor.MainActivity"
            android:targetPackage="com.shayor.apkextractor" />
    </shortcut>
</shortcuts>
